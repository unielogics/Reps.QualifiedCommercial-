# Same Clerk application as QCDashboard and audit.qualifiedcommercial.com — one
# login across those subdomains. Copy the LIVE keys (pk_live_/sk_live_) from the
# QC-Audit or QCDashboard Amplify env vars.
#
# Do NOT copy from QCWeb: the marketing site runs on a different Clerk instance
# (pk_test_), so its keys will not share a session with this app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Bare origin. The /api/v1 suffix is appended in src/lib/api.ts, not here.
NEXT_PUBLIC_API_URL=https://api.qualifiedcommercial.com

# Where a rep crosses over to the full client cockpit.
NEXT_PUBLIC_AUDIT_URL=https://audit.qualifiedcommercial.com
